# 이 파일을 keystore.properties 로 복사한 뒤 실제 값을 채워 넣으세요.
# keystore.properties와 .jks 파일은 .gitignore에 있습니다. 절대 커밋하지 마세요.
#
# 키스토어 만들기 (프로젝트 루트에서 실행):
#
#   keytool -genkeypair -v -keystore vatradar-release.jks ^
#     -alias vatradar -keyalg RSA -keysize 4096 -validity 10000
#
# ⚠️ 이 키를 잃어버리면 Play에 올린 앱을 다시는 업데이트할 수 없습니다.
#    .jks 파일과 비밀번호를 반드시 별도의 안전한 곳에 백업하세요.
#    (Play App Signing을 쓰면 업로드 키 분실 시 재발급이 가능하니 함께 활성화하시길 권합니다)

storeFile=vatradar-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=vatradar
keyPassword=여기에_키_비밀번호
