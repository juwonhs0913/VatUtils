<?xml version="1.0" encoding="utf-8"?>
<!--
  AppCompat 테마를 쓰는 이유는 앱별 언어 설정(AppCompatDelegate.setApplicationLocales) 때문입니다.
  AppCompatActivity는 Theme.AppCompat 계열이 아니면 실행 시 예외를 던집니다.

  실제 색상/타이포는 Compose의 MaterialTheme이 담당하고,
  이 XML 테마는 앱 시작 시 윈도우 배경과 시스템 바만 결정합니다.
  DayNight 계열이라 다크 모드는 이 한 줄로 함께 처리됩니다.
-->
<resources>
    <style name="Theme.VATFlight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
